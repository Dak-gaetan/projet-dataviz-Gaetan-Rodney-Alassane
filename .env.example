# Copier en .env : cp .env.example .env   (le .env n'est jamais commité)

# --- RustFS (data lake, API compatible S3) ---
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin
RUSTFS_ENDPOINT=http://localhost:9000
LAKE_BUCKET=velib

# --- PostgreSQL (couche gold) ---
POSTGRES_USER=velib
POSTGRES_PASSWORD=velib
POSTGRES_DB=velib_gold
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Jupyter ---
JUPYTER_TOKEN=velib

# --- Téléchargement des données (voir scripts/telecharger_donnees.sh) ---
# Jeu temps réel Paris Open Data (instantané des stations)
VELIB_STATUS_URL=https://opendata.paris.fr/api/explore/v2.1/catalog/datasets/velib-disponibilite-en-temps-reel/exports/csv?delimiter=%3B
# Intervalle entre deux instantanés (secondes) et durée de collecte (minutes)
COLLECT_INTERVAL_S=300
COLLECT_DURATION_MIN=60
