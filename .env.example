# Copier en .env : cp .env.example .env   (le .env n'est jamais commité)

# --- RustFS (data lake, API compatible S3) ---
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin
RUSTFS_ENDPOINT=http://localhost:9000
LAKE_BUCKET=velib

# --- PostgreSQL (couche gold) ---
POSTGRES_USER=velib
POSTGRES_PASSWORD=velib
POSTGRES_DB=velib_gold
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Jupyter (uniquement si profil Docker "jupyter" activé) ---
JUPYTER_TOKEN=velib

# --- Notebooks locaux (VS Code) : permet "import config" depuis src/ ---
PYTHONPATH=src
DATA_DIR=data

# --- Collecte des données (src/collecter_velib.py, service Docker "collector") ---
# CSV « Vélib - disponibilité temps réel » (permalien data.gouv.fr). Plusieurs URL possibles,
# séparées par des virgules : elles sont essayées dans l'ordre.
VELIB_STATUS_URL=https://www.data.gouv.fr/api/1/datasets/r/0845c838-6f18-40c3-936f-da204107759a
# Secondes entre deux instantanés (120 = un instantané toutes les 2 min)
COLLECT_INTERVAL_S=120
# Durée maximale en minutes, 0 = tourne jusqu'à l'arrêt
COLLECT_DURATION_MIN=0

# --- Java pour Spark ---
# Spark 3.5 exige Java 17 (ou 11). Si `java -version` affiche une autre version (21, 25...),
# installer Temurin 17 et indiquer son dossier ici (sans guillemets), par exemple :
# SPARK_JAVA_HOME=C:\Program Files\Eclipse Adoptium\jdk-17.0.13.11-hotspot

# --- Hadoop sous Windows (winutils) ---
# Dossier contenant bin\winutils.exe et bin\hadoop.dll (voir README, « Spark sous Windows »).
# Inutile sous Linux / macOS.
# HADOOP_HOME=D:\hadoop
